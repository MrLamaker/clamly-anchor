{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "noEmit": true,
    "types": ["node", "chrome"],
    "paths": {
      "@clamly/anchor": ["../packages/core/src/index.ts"],
      "@clamly/anchor-react": ["../packages/react/src/index.ts"],
      "@clamly/anchor-vue": ["../packages/vue/src/index.ts"],
      "@clamly/anchor-svelte": ["../packages/svelte/src/index.ts"]
    }
  },
  "include": ["tests/**/*.ts", "fixtures/**/*.ts", "fixtures/**/*.tsx", "*.ts"]
}
