{
  "$schema": "https://schema.railpack.com",
  "steps": {
    "install": {
      "commands": ["pnpm install"]
    },
    "build": {
      "inputs": [{ "step": "install" }],
      "commands": ["pnpm --filter @clamly/anchor-web build"],
      "deployOutputs": [{ "include": ["."] }]
    }
  },
  "deploy": {
    "startCommand": "pnpm --filter @clamly/anchor-web run start"
  }
}
