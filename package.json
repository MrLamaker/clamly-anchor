{
  "name": "clamly-anchor",
  "version": "0.1.0",
  "private": true,
  "description": "An open-source cognitive accessibility reader by Clamly.",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "build": "pnpm --recursive run build",
    "build:extension": "pnpm --filter @clamly/anchor-extension build",
    "dev:web": "pnpm --filter @clamly/anchor-web dev",
    "typecheck": "pnpm --recursive run typecheck",
    "test": "pnpm --recursive run test"
  },
  "devDependencies": {
    "typescript": "^5.7.3"
  }
}
